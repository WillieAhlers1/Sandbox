# GCP ML Framework — project config
# Copy to .env and fill in real values. Never commit .env.

# --- Identity (required) ---
TEAM=mlplatform
PROJECT=second_run
ENVIRONMENT=local
# BRANCH is auto-detected from git in local mode

# --- GCP (required for non-local) ---
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-east4

# --- Cloud Composer (required for deploy/run) ---
# GCP_COMPOSER_DAGS_PATH=gs://composer-bucket/dags
# GCP_PIPELINE_SERVICE_ACCOUNT_EMAIL=sa@project.iam.gserviceaccount.com
